<UserControl x:Class="DiGi.UI.WPF.Controls.VisualBackgroundTasksControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiGi.UI.WPF.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="400" d:DesignWidth="800">
    <Grid Background="#FFE5E5E5">
        <DataGrid ItemsSource="{Binding VisualBackgroundTasks, ElementName=Root}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  SelectionUnit="FullRow" 
                  SelectionMode="Single" 
                  HeadersVisibility="Column">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
            </DataGrid.Resources>
            <DataGrid.Columns>

                <!-- The names are long - "Report BuildingModels without a building (dry run, deletes nothing)" is derived
                     from a task's DryRun rather than written short, so shortening them is not an option - and the column
                     is whatever the fixed columns leave over. Stretch is what lets the TextBlock measure against the
                     real column width: centred, it sized itself to the text and was clipped at BOTH ends, losing the
                     start of the name. Wrap then grows the row instead of cutting, MaxHeight caps that growth at three
                     lines, and the trimming only becomes reachable once that cap is hit. ToolTipText, rather than
                     Description on its own, is what makes a trimmed name readable again on hover. A MultiBinding of
                     Name and Description would be the way to compose it here, but Setter.Value takes a single Binding
                     and drops a MultiBinding without a compile error or a runtime warning - the tooltip simply never
                     appears - so the two are joined in the view model instead. -->
                <DataGridTextColumn Header="Task Name" Binding="{Binding Name}" Width="*" MinWidth="200" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Left" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="MaxHeight" Value="54" />
                            <Setter Property="Margin" Value="4,2,4,2" />
                            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- The cell shows the status and hovers the exception, but a tooltip cannot be selected. Ctrl+C on
                     a row copies each column's ClipboardContentBinding, so pointing this one at StatusText puts the
                     whole failure - type, message and stack trace - on the clipboard, and the status when it passed. -->
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" ClipboardContentBinding="{Binding StatusText}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="{Binding ExceptionText}" />
                            <Style.Triggers>
                                <Trigger Property="ToolTip" Value="{x:Null}">
                                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                </Trigger>
                                <Trigger Property="ToolTip" Value="">
                                    <Setter Property="ToolTipService.IsEnabled" Value="False" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Duration" Binding="{Binding ExecutionTimeSpanText}" Width="75" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Action" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding ToggleText}" 
                                    Command="{Binding ToggleCommandAsync}"
                                    IsEnabled="{Binding CanToggle}"
                                    Margin="2,2,2,2" 
                                    HorizontalAlignment="Center" 
                                    MinWidth="65" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
